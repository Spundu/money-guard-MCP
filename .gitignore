# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# test / coverage
coverage/

# environment & secrets — never commit
.env
.env.*
*.pem
*.key

# editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# logs
npm-debug.log*

# npm pack and bundle output
*.tgz
pack.json
*.mcpb

# eval: the Python environment, caches, and every log except the published run
eval/.venv/
__pycache__/
.pytest_cache/
eval/logs/*
!eval/logs/run1/
